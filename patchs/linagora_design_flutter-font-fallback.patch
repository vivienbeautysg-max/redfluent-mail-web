+  // Redfluent Mail patch (v0.39.3-rf6, release-mode logging in rf7), see
+  // https://github.com/linagora/linagora-design-flutter/issues/78
+  //
+  // The styles name the bundled family in full instead of through `package:`:
+  // Flutter prefixes every `fontFamilyFallback` entry of a packaged style with
+  // `packages/<package>/`, so a packaged style - and every Text merged with it,
+  // which inherits its `package` - could only use TwakeInter. Characters
+  // TwakeInter lacks (Chinese, Arabic, emoji...) then waited for the web
+  // engine's glyph fallback (download a font slice, lay out again) and were
+  // drawn as boxes meanwhile.
+  static const String _packagedFontFamily = 'packages/$_package/$_fontFamily';
+
+  static List<String>? _fontFamilyFallback;
+  static bool _stylesBuilt = false;
+
+  /// Families tried, in order, for characters TwakeInter does not have. Every
+  /// style of this design system carries them. The styles are built once and
+  /// cached, so set this before the first one is read. Setting a different
+  /// list afterwards is a startup-order bug: debug and profile builds throw a
+  /// [StateError]; a release build logs it and keeps the list the styles were
+  /// built with, so the app still starts.
+  static List<String>? get fontFamilyFallback => _fontFamilyFallback;
+
+  static set fontFamilyFallback(List<String>? families) =>
+      _setFontFamilyFallback(families, releaseMode: kReleaseMode);
+
+  /// The [fontFamilyFallback] setter with the build mode as a parameter.
+  @visibleForTesting
+  static void debugSetFontFamilyFallback(
+    List<String>? families, {
+    required bool releaseMode,
+  }) =>
+      _setFontFamilyFallback(families, releaseMode: releaseMode);
+
+  static void _setFontFamilyFallback(
+    List<String>? families, {
+    required bool releaseMode,
+  }) {
+    if (listEquals(families, _fontFamilyFallback)) return;
+    if (_stylesBuilt) {
+      const message = 'LinagoraTextTheme.fontFamilyFallback must be set '
+          'before the first design system text style is built';
+      if (!releaseMode) throw StateError(message);
+      debugPrint('$message; keeping the list the styles were built with.');
+      return;
+    }
+    _fontFamilyFallback = families == null ? null : List.unmodifiable(families);
+  }
+
+  static TextStyle _withFont(TextStyle style) {
+    _stylesBuilt = true;
+    return style.apply(
+      fontFamily: _packagedFontFamily,
+      fontFamilyFallback: _fontFamilyFallback,
+    );
+  }
+
